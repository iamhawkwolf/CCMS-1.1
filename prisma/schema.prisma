// V1 data model. Every tenant-owned row carries consultancyId; client-owned rows also carry clientId.
// Money is stored in paise (integer) to avoid float errors.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  STARTER
  GROWTH
  PRO
}

enum Role {
  ADMIN
  CONSULTANT
  CLIENT_USER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum ComplianceKind {
  PF
  ESI
  PT
  TDS
  LWF
}

enum RequisitionStatus {
  OPEN
  ON_HOLD
  CLOSED
}

enum RequisitionSource {
  PORTAL
  CONSULTANT
}

enum ProfileStage {
  SUBMITTED
  SHORTLISTED
  INTERVIEW_SCHEDULED
  OFFERED
  JOINED
  REJECTED
}

enum FeeModel {
  RETAINER
  FIXED
  HOURLY
  PER_HEAD
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  VOID
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENDING // claimed by a worker; reset to PENDING if the worker dies
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
}

model Consultancy {
  id               String   @id @default(cuid())
  name             String
  gstin            String?
  state            String? // state code used for GST place of supply, e.g. "KA"
  address          String?
  logoUrl          String?
  plan             Plan     @default(STARTER)
  nextInvoiceNo    Int      @default(1)
  invoicePrefix    String   @default("INV")
  // Demo accounts never send a real WhatsApp message or email, and are the only data the demo reset touches.
  isDemo           Boolean  @default(false)
  createdAt        DateTime @default(now())

  users            User[]
  clients          Client[]
  featureSettings  FeatureSetting[]
  featureChangeLog FeatureChangeLog[]
  tasks            Task[]
  requisitions     Requisition[]
  invoices         Invoice[]
  notifications    Notification[]
  auditLogs        AuditLog[]
}

model User {
  id             String   @id @default(cuid())
  consultancyId  String
  // Set only for CLIENT_USER: the single client company this login can see.
  clientId       String?
  email          String   @unique
  name           String
  passwordHash   String
  role           Role
  phone          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  // Sessions issued before this moment are rejected. Set when the password is reset.
  passwordChangedAt DateTime?

  consultancy    Consultancy        @relation(fields: [consultancyId], references: [id], onDelete: Cascade)
  client         Client?            @relation("ClientUsers", fields: [clientId], references: [id], onDelete: Cascade)
  resetTokens    PasswordResetToken[]
  assignments    ClientAssignment[]
  assignedTasks  Task[]             @relation("TaskAssignee")
  timeEntries    TimeEntry[]

  @@index([consultancyId])
  @@index([clientId])
}

model Client {
  id             String   @id @default(cuid())
  consultancyId  String
  name           String
  gstin          String?
  state          String // state code, e.g. "KA"; drives compliance rules and GST
  address        String?
  // Statutory registrations: a number being present switches that compliance on.
  pfNumber       String?
  esiNumber      String?
  ptNumber       String?
  tan            String?
  lwfNumber      String?
  notes          String?
  active         Boolean  @default(true)
  reviewReminderDays Int  @default(3) // remind client if profiles sit unreviewed this long
  createdAt      DateTime @default(now())

  consultancy    Consultancy        @relation(fields: [consultancyId], references: [id], onDelete: Cascade)
  contacts       ClientContact[]
  employees      Employee[]
  assignments    ClientAssignment[]
  portalUsers    User[]             @relation("ClientUsers")
  tasks          Task[]
  requisitions   Requisition[]
  invoices       Invoice[]
  featureSettings FeatureSetting[]

  @@index([consultancyId])
}

model ClientContact {
  id        String  @id @default(cuid())
  clientId  String
  name      String
  email     String?
  phone     String? // WhatsApp-capable number, E.164
  title     String?
  isPrimary Boolean @default(false)

  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

// Which consultants work on which client. Admins see all clients regardless.
model ClientAssignment {
  userId   String
  clientId String

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([userId, clientId])
}

model Employee {
  id          String    @id @default(cuid())
  clientId    String
  empCode     String?
  name        String
  email       String?
  phone       String?
  designation String?
  department  String?
  joinedOn    DateTime?
  exitedOn    DateTime?
  createdAt   DateTime  @default(now())

  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

// Feature switch. scope is "ACCOUNT" for the consultancy default, or a clientId for a per-client override.
// (A string scope instead of a nullable clientId keeps the unique constraint honest in Postgres.)
model FeatureSetting {
  id            String   @id @default(cuid())
  consultancyId String
  scope         String
  clientId      String?
  key           String
  enabled       Boolean
  updatedAt     DateTime @updatedAt

  consultancy   Consultancy @relation(fields: [consultancyId], references: [id], onDelete: Cascade)
  client        Client?     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([consultancyId, scope, key])
}

model FeatureChangeLog {
  id            String   @id @default(cuid())
  consultancyId String
  clientId      String?
  key           String
  oldValue      Boolean?
  newValue      Boolean
  changedById   String
  changedAt     DateTime @default(now())

  consultancy   Consultancy @relation(fields: [consultancyId], references: [id], onDelete: Cascade)

  @@index([consultancyId, changedAt])
}

model Task {
  id             String         @id @default(cuid())
  consultancyId  String
  clientId       String
  title          String
  description    String?
  status         TaskStatus     @default(TODO)
  dueDate        DateTime
  assigneeId     String?
  completedAt    DateTime?
  // Compliance tasks are generated per (client, kind, period). sourceKey makes generation idempotent.
  complianceKind ComplianceKind?
  period         String? // "2026-10" = the month the filing is for
  sourceKey      String?        @unique
  // Simple recurrence for non-compliance tasks, e.g. "MONTHLY". Next task is created when this one is done.
  recurrence     String?
  budgetMinutes  Int?
  createdAt      DateTime       @default(now())

  consultancy    Consultancy    @relation(fields: [consultancyId], references: [id], onDelete: Cascade)
  client         Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignee       User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  timeEntries    TimeEntry[]

  @@index([consultancyId, status, dueDate])
  @@index([clientId])
}

model TimeEntry {
  id        String    @id @default(cuid())
  taskId    String
  userId    String
  startedAt DateTime
  endedAt   DateTime?
  minutes   Int       @default(0)

  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Requisition {
  id            String            @id @default(cuid())
  consultancyId String
  clientId      String
  title         String
  openings      Int               @default(1)
  budgetMin     Int? // annual CTC in rupees
  budgetMax     Int?
  deadline      DateTime?
  status        RequisitionStatus @default(OPEN)
  source        RequisitionSource @default(CONSULTANT)
  createdById   String?
  createdAt     DateTime          @default(now())
  closedAt      DateTime?

  consultancy   Consultancy       @relation(fields: [consultancyId], references: [id], onDelete: Cascade)
  client        Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  profiles      Profile[]
  jds           JobDescription[]

  @@index([consultancyId, status])
  @@index([clientId])
}

// A candidate profile submitted against one requisition.
model Profile {
  id               String       @id @default(cuid())
  requisitionId    String
  name             String
  phone            String?
  email            String?
  // Normalised copies used for duplicate detection (digits only / lowercase).
  phoneKey         String?
  emailKey         String?
  currentCompany   String?
  experienceYears  Decimal?     @db.Decimal(4, 1)
  currentCtc       Int?
  expectedCtc      Int?
  noticeDays       Int?
  resumeUrl        String?
  // Resume-to-JD match, set when the profile is submitted from the match screen. Null for profiles added by hand.
  // Internal to the consultancy: never shown in the client portal.
  matchScore       Int?
  matchMethod      String? // "rules" | "ollama" | "claude"
  matchedAt        DateTime?
  matchDetail      Json? // band, breakdown, matched and missing skills, summary, warnings. No contact details.
  stage            ProfileStage @default(SUBMITTED)
  clientComment    String?
  submittedAt      DateTime     @default(now())
  stageChangedAt   DateTime     @default(now())
  lastReminderAt   DateTime?

  requisition      Requisition  @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  events           ProfileEvent[]
  interviews       Interview[]

  @@index([requisitionId, stage])
  @@index([phoneKey])
  @@index([emailKey])
}

model ProfileEvent {
  id        String        @id @default(cuid())
  profileId String
  fromStage ProfileStage?
  toStage   ProfileStage
  comment   String?
  actorId   String?
  at        DateTime      @default(now())

  profile   Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Interview {
  id          String   @id @default(cuid())
  profileId   String
  scheduledAt DateTime
  mode        String? // "VIDEO" | "PHONE" | "ONSITE"
  location    String?
  feedback    String?
  createdAt   DateTime @default(now())

  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model JobDescription {
  id            String   @id @default(cuid())
  requisitionId String
  originalText  String
  maskedText    String // text after number/email masking, as approved by the consultant
  watermarkName String? // consultant name stamped on the JD
  approved      Boolean  @default(false)
  createdById   String?
  createdAt     DateTime @default(now())

  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  shareLinks    ShareLink[]

  @@index([requisitionId])
}

model ShareLink {
  id          String    @id @default(cuid())
  token       String    @unique
  jdId        String
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  jd          JobDescription @relation(fields: [jdId], references: [id], onDelete: Cascade)
  views       ShareLinkView[]

  @@index([jdId])
}

model ShareLinkView {
  id        String   @id @default(cuid())
  linkId    String
  viewedAt  DateTime @default(now())
  ip        String?
  userAgent String?

  link      ShareLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
}

model Invoice {
  id               String        @id @default(cuid())
  consultancyId    String
  clientId         String
  number           String
  status           InvoiceStatus @default(DRAFT)
  feeModel         FeeModel      @default(RETAINER)
  issueDate        DateTime      @default(now())
  dueDate          DateTime
  placeOfSupply    String // state code
  subtotalPaise    Int
  cgstPaise        Int           @default(0)
  sgstPaise        Int           @default(0)
  igstPaise        Int           @default(0)
  totalPaise       Int
  paymentLinkUrl   String?
  lastReminderAt   DateTime?
  createdAt        DateTime      @default(now())

  consultancy      Consultancy   @relation(fields: [consultancyId], references: [id], onDelete: Cascade)
  client           Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lines            InvoiceLine[]
  payments         Payment[]

  @@unique([consultancyId, number])
  @@index([consultancyId, status, dueDate])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  sac         String  @default("998512") // SAC for recruitment/HR services; confirm with your CA
  quantity    Decimal @db.Decimal(10, 2)
  ratePaise   Int
  amountPaise Int

  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id         String   @id @default(cuid())
  invoiceId  String
  amountPaise Int
  method     String // "UPI" | "RAZORPAY" | "BANK" | "CASH"
  reference  String?
  paidAt     DateTime @default(now())

  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// Outbox: everything the system wants to send goes here first, then the worker delivers it.
// IN_APP rows double as the user's inbox (`to` is the user id).
model Notification {
  id                String              @id @default(cuid())
  consultancyId     String
  clientId          String?
  channel           NotificationChannel
  to                String
  template          String
  payload           Json
  status            NotificationStatus  @default(PENDING)
  scheduledFor      DateTime            @default(now())
  sentAt            DateTime?
  readAt            DateTime?
  error             String?
  attempts          Int                 @default(0)
  claimedAt         DateTime?
  providerMessageId String?             @unique
  // Same key twice = same alert, so repeated job runs never double-send.
  dedupeKey         String?             @unique
  createdAt         DateTime            @default(now())

  consultancy       Consultancy         @relation(fields: [consultancyId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([channel, to, createdAt])
}

// People who replied STOP on WhatsApp. We never message these numbers (digits only, with country code).
model WhatsAppOptOut {
  phone     String   @id
  reason    String?
  createdAt DateTime @default(now())
}

// One row per scheduled job: last run, and a lease so two workers never run the same job at once.
model JobState {
  name           String    @id
  lastStartedAt  DateTime?
  lastFinishedAt DateTime?
  lockedUntil    DateTime?
  lastOk         Boolean?
  lastSummary    Json?
  lastError      String?
}

model AuditLog {
  id            String   @id @default(cuid())
  consultancyId String
  userId        String?
  action        String
  entity        String
  entityId      String?
  meta          Json?
  at            DateTime @default(now())

  consultancy   Consultancy @relation(fields: [consultancyId], references: [id], onDelete: Cascade)

  @@index([consultancyId, at])
}

// One row per password-reset link. Only a hash of the token is stored, so a database leak cannot be used to reset accounts.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A hit against a rate limit (failed sign-ins, reset requests). Plain table so it works on any host, serverless included.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
