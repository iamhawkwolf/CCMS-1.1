# Postgres connection (matches docker-compose.yml)
DATABASE_URL="postgresql://ccms:ccms@localhost:5432/ccms?schema=public"

# Long random string used to sign login cookies. Generate: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Public base URL, used in share links and emails
APP_URL="http://localhost:3000"

# Notifications. "console" just logs messages; swap for a real provider later.
NOTIFY_PROVIDER="console"
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_ID=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
