# Postgres connection (matches docker-compose.yml)
DATABASE_URL="postgresql://banyanroot:banyanroot@localhost:5432/banyanroot?schema=public"

# Long random string used to sign login cookies. Generate: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Public base URL, used in share links and emails
APP_URL="http://localhost:3000"

# ── Demo and sign-up ─────────────────────────────────────────
# DEMO_MODE=1 shows "Explore as Admin / Consultant / Client" buttons on the sign-in page (one click, no password).
# They sign in to the demo consultancy only, whose data is fake and which never sends a real message.
# Default: on in development, off in production until you set it.
DEMO_MODE=1
# Password for the demo logins (admin@demo.test and so on). Locally it defaults to demo12345;
# in production it is random unless you set it here.
# DEMO_PASSWORD=
# Open self-service sign-up. Default: on in development, off (invite-only) in production.
# ALLOW_SIGNUP=1

# ── Scheduler ────────────────────────────────────────────────
# Secret for GET/POST /api/cron (16+ chars). Generate: openssl rand -base64 24
# Not needed if you run `npm run worker` instead.
CRON_SECRET="change-me-to-another-long-random-string"

# ── WhatsApp ─────────────────────────────────────────────────
# "console" logs the message instead of sending it (fine for development).
# "cloud" sends through Meta's WhatsApp Business Cloud API and needs everything below.
WHATSAPP_PROVIDER="console"
# WHATSAPP_TOKEN=                 # permanent system-user access token
# WHATSAPP_PHONE_NUMBER_ID=       # the sending number's ID (not the phone number itself)
# WHATSAPP_APP_SECRET=            # Meta app secret, used to verify webhook signatures
# WHATSAPP_VERIFY_TOKEN=          # any string you choose; paste the same one into Meta's webhook setup
# WHATSAPP_API_VERSION="v23.0"    # check Meta's current supported Graph API version
# WHATSAPP_API_BASE="https://graph.facebook.com"

# "console" prints emails in development only (production prints nothing, because a reset link is a password).
# No real email provider is wired up yet: password-reset emails are not sent until one is added in src/lib/email.ts.
EMAIL_PROVIDER="console"

# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# ── Resume reading ───────────────────────────────────────────
# rules  = built-in rules only (free, instant, nothing leaves the server)
# ollama = self-hosted model on our own server (data stays with us; needs RAM, see docs/resume-parser-sizing.md)
# claude = hosted API (most accurate; resume text goes to Anthropic)
RESUME_EXTRACTOR="rules"
# OLLAMA_URL="http://localhost:11434"
# OLLAMA_MODEL="qwen2.5:3b-instruct"
# OLLAMA_CONCURRENCY=1            # resumes read at the same time; keep at 1 on a small server
# ANTHROPIC_API_KEY=
# RESUME_CLAUDE_MODEL="claude-haiku-5-5"
